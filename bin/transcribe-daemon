#!/usr/bin/env python3
"""Persistent transcription daemon: loads faster-whisper once, serves
transcription requests over a Unix socket to avoid the ~15-20s model-load
cost on every dictation. Protocol: client sends a WAV file path followed
by a newline; daemon replies with the transcript text followed by a
newline, then closes the connection.
"""
import os
import socket
import socketserver
import sys

from faster_whisper import WhisperModel

SOCKET_PATH = f"/run/user/{os.getuid()}/transcribe.sock"

MODEL_NAME = os.environ.get("WAYLISPER_MODEL", "large-v3-turbo")
CPU_THREADS = int(os.environ.get("WAYLISPER_THREADS", os.cpu_count() or 4))
# Beam search explores this many hypotheses per decoding step; the encoder
# pass (which scales with audio length, not this) dominates wall-clock time
# for typical dictation-length clips, so beam_size=1 (greedy) trades away
# little accuracy for a modest but real speedup. Bump it back up via the env
# var if you notice it mangling harder audio (accents, background noise).
BEAM_SIZE = int(os.environ.get("WAYLISPER_BEAM_SIZE", 1))
# How much audio VAD keeps as a buffer around detected speech before trimming
# the rest as silence. Too tight and it can clip a word that trails off in
# volume right as you stop talking; too loose and the extra trailing silence
# is enough to trigger Whisper's well-documented hallucination mode where it
# fills silence with YouTube-trained sign-off phrases ("thanks for
# watching"). Was 700ms (bumped up from faster-whisper's own 400ms default
# to avoid clipping) but that turned out to overshoot into hallucination
# territory on path0s -- pulled back toward the library default. `dictate`
# also adds its own 300ms raw recording buffer *before* this pad ever
# applies, so the two stack; if hallucination comes back, that's the other
# knob to check.
VAD_PAD_MS = int(os.environ.get("WAYLISPER_VAD_PAD_MS", 400))

print("Loading model...", flush=True)
model = WhisperModel(MODEL_NAME, device="cpu", compute_type="int8", cpu_threads=CPU_THREADS)
print("Model loaded, ready.", flush=True)


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        try:
            wav_path = self.rfile.readline().decode("utf-8").strip()
            if not wav_path or not os.path.isfile(wav_path):
                self.wfile.write(b"\n")
                return
            # vad_filter strips silence/non-speech before it ever reaches the
            # model. Whisper-family models are trained on huge amounts of
            # YouTube audio and learned to fill trailing silence with
            # sign-off phrases ("thanks for watching", "I'll see you next
            # time") instead of correctly outputting nothing — this is a
            # well-documented Whisper hallucination mode, not a bug specific
            # to this setup. VAD-filtering the silence out before transcribing
            # is the standard fix.
            segments, _ = model.transcribe(
                wav_path,
                language="en",
                beam_size=BEAM_SIZE,
                vad_filter=True,
                vad_parameters={"speech_pad_ms": VAD_PAD_MS},
            )
            text = " ".join(s.text.strip() for s in segments)
            self.wfile.write((text + "\n").encode("utf-8"))
        except Exception as e:
            print(f"Error handling request: {e}", file=sys.stderr, flush=True)
            self.wfile.write(b"\n")


class Server(socketserver.UnixStreamServer):
    allow_reuse_address = True


if os.path.exists(SOCKET_PATH):
    os.remove(SOCKET_PATH)

server = Server(SOCKET_PATH, Handler)
os.chmod(SOCKET_PATH, 0o600)
print(f"Listening on {SOCKET_PATH}", flush=True)
server.serve_forever()
