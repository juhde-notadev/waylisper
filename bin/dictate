#!/usr/bin/env bash
# Push-to-talk dictation: records from an ALSA capture device, transcribes
# via the persistent transcribe-daemon (falls back to whisper.cpp if the
# daemon's down), and copies the result to the Wayland clipboard.
set -uo pipefail

WHISPER_BIN="$HOME/src/whisper.cpp/build/bin/whisper-cli"
MODEL="$HOME/src/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin"

# ALSA capture device. `arecord -L` lists devices. Defaults to path0s's
# built-in mic array, which lives on the AMD ACP path (card "acp6x"), NOT
# the HD-Audio codec (card "Generic_1" — that one's the analog 3.5mm jack,
# not the internal mic). Confirmed via volumedetect: Generic_1 captured pure
# noise floor (-78dB) even with real speech; acp6x captured real signal
# (-11dB). Override with WAYLISPER_ALSA_DEVICE for a different source (e.g.
# a phone mic via AndroidMic, as the upstream README describes).
#
# Also confirmed: this laptop hardware-gates the mic array when the lid is
# closed — independent of any OS-level mute/capture-switch state. Dictation
# only works with the lid open.
ALSA_DEVICE="${WAYLISPER_ALSA_DEVICE:-sysdefault:CARD=acp6x}"

DAEMON_SOCKET="/run/user/$(id -u)/transcribe.sock"

TMP_DIR=$(mktemp -d)
WAV="$TMP_DIR/rec.wav"
OUT_PREFIX="$TMP_DIR/out"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

arecord -D "$ALSA_DEVICE" -f S16_LE -r 16000 -c 1 -t wav "$WAV" >/dev/null 2>&1 &
REC_PID=$!

# Direct ALSA capture starts near-instantly (no pipewire-pulse graph
# negotiation delay), so no warmup wait needed here.
sleep 0.2

echo "Recording... speak now, press Enter to stop."
read -r

# Small trailing buffer so words spoken right up to the Enter press aren't
# clipped before the stop signal reaches arecord.
sleep 0.3

kill -INT "$REC_PID" 2>/dev/null
wait "$REC_PID" 2>/dev/null

if [ ! -s "$WAV" ]; then
    echo "No audio captured." >&2
    exit 1
fi

echo "Transcribing..."

if [ -S "$DAEMON_SOCKET" ]; then
    TEXT=$("$HOME/.local/bin/transcribe-client" "$WAV" 2>/dev/null)
fi

if [ -z "${TEXT:-}" ]; then
    if [ ! -x "$WHISPER_BIN" ] || [ ! -f "$MODEL" ]; then
        echo "No transcription backend available (daemon down, and no whisper.cpp fallback installed)." >&2
        exit 1
    fi
    "$WHISPER_BIN" -m "$MODEL" -f "$WAV" -t "$(nproc)" -l en -nt -np -otxt -of "$OUT_PREFIX" >/dev/null 2>&1
    TEXT_FILE="$OUT_PREFIX.txt"
    if [ ! -f "$TEXT_FILE" ]; then
        echo "Transcription failed." >&2
        exit 1
    fi
    TEXT=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' "$TEXT_FILE")
fi

if [ -z "$TEXT" ]; then
    echo "No speech detected."
    exit 0
fi

# xsel forks to background to serve the clipboard, so it would otherwise
# inherit and hold open any lock file descriptor (e.g. fd 200, used by
# dictate-autotype's overlap guard) indefinitely. 200>&- closes that fd for
# xsel specifically without affecting this script.
printf '%s' "$TEXT" | xsel --clipboard --input 200>&-
printf '%s' "$TEXT" > "${TMPDIR:-/tmp}/waylisper-last.txt"

echo "--- Transcript ---"
echo "$TEXT"
echo "------------------"
echo "Copied to clipboard. Paste with Ctrl+Shift+V (or middle-click for X11 primary selection)."
