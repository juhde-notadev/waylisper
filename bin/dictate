#!/usr/bin/env bash
# Push-to-talk dictation: records from an ALSA capture device, transcribes
# with whisper.cpp (large-v3-turbo), copies the result to the Wayland
# clipboard.
set -uo pipefail

WHISPER_BIN="$HOME/src/whisper.cpp/build/bin/whisper-cli"
# Tested q5_0 as a further speed upgrade - came back slower (6.6s vs 4.99s
# on the same test clip) and lower quality. Whisper.cpp's kernels on this
# CPU are apparently better optimized for q8_0. Staying here.
MODEL="$HOME/src/whisper.cpp/models/ggml-large-v3-turbo-q8_0.bin"

# Switched from parecord (PulseAudio-compat layer) to direct ALSA - the
# same general approach this machine already uses for REAPER to keep
# recording latency low. Also incidentally fixes the ~2s PipeWire warmup
# delay parecord needed; direct ALSA starts flowing almost instantly, so
# that whole sleep is gone too.
ALSA_DEVICE="android_mic"

if [ ! -x "$WHISPER_BIN" ]; then
    echo "whisper-cli not found at $WHISPER_BIN" >&2
    exit 1
fi
if [ ! -f "$MODEL" ]; then
    echo "model not found at $MODEL" >&2
    exit 1
fi

TMP_DIR=$(mktemp -d)
WAV="$TMP_DIR/rec.wav"
OUT_PREFIX="$TMP_DIR/out"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

arecord -D "$ALSA_DEVICE" -f S16_LE -r 16000 -c 1 -t wav "$WAV" >/dev/null 2>&1 &
REC_PID=$!

sleep 0.2

echo "Recording... speak now, press Enter to stop."
read -r

# Small trailing buffer so words spoken right up to the Enter press aren't
# clipped before the stop signal reaches arecord. Found this while testing
# longer dictations - the last word or two kept getting cut off.
sleep 0.3

kill -INT "$REC_PID" 2>/dev/null
wait "$REC_PID" 2>/dev/null

if [ ! -s "$WAV" ]; then
    echo "No audio captured." >&2
    exit 1
fi

echo "Transcribing..."

DAEMON_SOCKET="/run/user/1000/transcribe.sock"
if [ -S "$DAEMON_SOCKET" ]; then
    TEXT=$("$HOME/.local/bin/transcribe-client" "$WAV" 2>/dev/null)
fi

if [ -z "${TEXT:-}" ]; then
    "$WHISPER_BIN" -m "$MODEL" -f "$WAV" -t 16 -l en -nt -np -otxt -of "$OUT_PREFIX" >/dev/null 2>&1
    TEXT_FILE="$OUT_PREFIX.txt"
    if [ ! -f "$TEXT_FILE" ]; then
        echo "Transcription failed." >&2
        exit 1
    fi
    TEXT=$(sed 's/^[[:space:]]*//;s/[[:space:]]*$//' "$TEXT_FILE")
fi

if [ -z "$TEXT" ]; then
    echo "No speech detected."
    exit 0
fi

printf '%s' "$TEXT" | wl-copy
printf '%s' "$TEXT" > /tmp/dictate_last.txt

echo "--- Transcript ---"
echo "$TEXT"
echo "------------------"
echo "Copied to clipboard. Paste with Ctrl+Shift+V."
