#!/usr/bin/env bash
# Runs `dictate` in its own terminal window, then once that window closes,
# types the result directly into whatever window regains focus and submits
# it with Enter. Meant to be bound to a global keyboard shortcut.
set -uo pipefail

# If the hotkey double-fires (or a session is already running), a second
# invocation just exits instead of starting an overlapping recording that
# splits one dictation into two separate typed/submitted messages.
LOCK_FILE="${TMPDIR:-/tmp}/waylisper-autotype.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    exit 0
fi

RESULT_FILE="${TMPDIR:-/tmp}/waylisper-last.txt"
rm -f "$RESULT_FILE"

# Remember the window that had focus before we steal it with xterm. Under
# Wayland/KWin, focus does NOT return to the previous window after an
# (XWayland) xterm closes — it goes nowhere — so ydotool's keystrokes below
# would be dropped into the void. kdotool (KWin-scripting xdotool clone)
# lets us re-activate the original window afterward. Degrades gracefully if
# kdotool isn't installed: PREV_WIN stays empty and we just skip the re-focus.
PREV_WIN=$(kdotool getactivewindow 2>/dev/null)

# Plain xterm on purpose: modern terminal emulators (kitty, konsole, etc.)
# have single-instance modes and close-confirmation dialogs that fight this
# kind of scripted, disposable window. xterm just closes when its child
# exits, no drama. See README's "gotchas" section for the full story.
xterm -T dictate -bg black -fg white -e "$HOME/.local/bin/dictate"

if [ ! -f "$RESULT_FILE" ]; then
    exit 0
fi

TEXT=$(cat "$RESULT_FILE")
if [ -z "$TEXT" ]; then
    exit 0
fi

# Re-activate the window that had focus before xterm, then give KWin a
# moment to settle before typing into it.
[ -n "${PREV_WIN:-}" ] && kdotool windowactivate "$PREV_WIN" 2>/dev/null
sleep 0.3

# -d 0 -H 0: no artificial per-keystroke delay. Comment out the `ydotool key`
# line below if you'd rather review the typed text before it submits.
YDOTOOL_SOCKET=/run/ydotoold.socket ydotool type -d 0 -H 0 -- "$TEXT"
# 28 = KEY_ENTER (see /usr/include/linux/input-event-codes.h); :1 press, :0 release.
YDOTOOL_SOCKET=/run/ydotoold.socket ydotool key 28:1 28:0
