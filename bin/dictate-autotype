#!/usr/bin/env bash
# Runs `dictate` in its own terminal window, then once that window closes,
# types the result directly into whatever window regains focus.
set -uo pipefail

# A journalctl check turned up multiple dictate-autotype instances actually
# overlapping in time - one continuous dictation was getting captured by
# two separate recording sessions at once, each independently transcribing
# and typing/submitting its own partial result. If the hotkey double-fires
# (or a session's already running), a second invocation now just exits
# instead of starting a competing recording.
LOCK_FILE=/tmp/dictate-autotype.lock
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    exit 0
fi

RESULT_FILE=/tmp/dictate_last.txt
rm -f "$RESULT_FILE"

# Gave up fighting kitty. This window isn't for interactive use - it's
# disposable plumbing - so it doesn't need to be kitty at all. Plain
# xterm has none of kitty's single-instance/close-confirmation baggage:
# it just closes when its child exits, like terminals have for decades.
xterm -T dictate -bg black -fg white -e "$HOME/.local/bin/dictate"

if [ ! -f "$RESULT_FILE" ]; then
    exit 0
fi

TEXT=$(cat "$RESULT_FILE")
if [ -z "$TEXT" ]; then
    exit 0
fi

sleep 0.4

YDOTOOL_SOCKET=/run/ydotoold.socket ydotool type -- "$TEXT"
YDOTOOL_SOCKET=/run/ydotoold.socket ydotool key 28:1 28:0
