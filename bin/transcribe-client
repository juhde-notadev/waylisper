#!/usr/bin/env python3
"""Sends a WAV file path to transcribe-daemon and prints the transcript."""
import os
import socket
import sys

if len(sys.argv) != 2:
    print("usage: transcribe-client <wav-path>", file=sys.stderr)
    sys.exit(1)

SOCKET_PATH = f"/run/user/{os.getuid()}/transcribe.sock"

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(SOCKET_PATH)
s.sendall((sys.argv[1] + "\n").encode("utf-8"))
s.shutdown(socket.SHUT_WR)

response = b""
while True:
    chunk = s.recv(4096)
    if not chunk:
        break
    response += chunk

print(response.decode("utf-8").strip())
