#!/usr/bin/env bash
# Claude Code Stop hook: speaks Claude's last response aloud via Piper TTS.
set -uo pipefail

MODEL="$HOME/.local/share/piper-voices/en_US-lessac-high.onnx"
TMP_WAV=$(mktemp --suffix=.wav)
trap 'rm -f "$TMP_WAV"' EXIT

INPUT=$(cat)
TEXT=$(printf '%s' "$INPUT" | jq -r '.last_assistant_message // empty')

if [ -z "$TEXT" ]; then
    exit 0
fi

CLEAN_TEXT=$(printf '%s' "$TEXT" | python3 -c '
import sys, re

text = sys.stdin.read()

text = re.sub(r"```.*?```", " code block omitted ", text, flags=re.DOTALL)
text = re.sub(r"`([^`]*)`", r"\1", text)
text = re.sub(r"\*\*\*(.*?)\*\*\*", r"\1", text)
text = re.sub(r"\*\*(.*?)\*\*", r"\1", text)
text = re.sub(r"\*(.*?)\*", r"\1", text)
text = re.sub(r"__(.*?)__", r"\1", text)
text = re.sub(r"_(.*?)_", r"\1", text)
text = re.sub(r"\[([^\]]*)\]\([^\)]*\)", r"\1", text)
text = re.sub(r"^#{1,6}\s*", "", text, flags=re.MULTILINE)
text = re.sub(r"^[\s]*[-*+]\s+", "", text, flags=re.MULTILINE)
text = re.sub(r"^\s*\d+\.\s+", "", text, flags=re.MULTILINE)
text = re.sub(r"\n{2,}", ". ", text)
text = re.sub(r"\n", " ", text)
text = re.sub(r"\s{2,}", " ", text)

sys.stdout.write(text.strip())
')

if [ -z "$CLEAN_TEXT" ]; then
    exit 0
fi

# A burst of rapid responses was causing every speak-response invocation
# to generate and play audio independently, with no coordination between
# them - the result was several voices overlapping and talking over each
# other at once. Claim "latest" before playing; if a newer invocation
# overwrites this first, we're stale and should skip instead of queuing
# behind it.
TOKEN="$$-$RANDOM"
LATEST_FILE=/tmp/speak-response-latest
LOCK_FILE=/tmp/speak-response.lock
echo "$TOKEN" > "$LATEST_FILE"

printf '%s' "$CLEAN_TEXT" | python3 -m piper -m "$MODEL" -f "$TMP_WAV" >/dev/null 2>&1

(
    flock -x 200
    if [ "$(cat "$LATEST_FILE" 2>/dev/null)" = "$TOKEN" ]; then
        paplay "$TMP_WAV" >/dev/null 2>&1
    fi
) 200>"$LOCK_FILE"
