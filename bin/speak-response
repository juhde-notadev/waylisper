#!/usr/bin/env bash
# Claude Code Stop hook: speaks Claude's last response aloud via Piper TTS.
# Wire it up in settings.json under hooks.Stop — see README.
set -uo pipefail

VOICES_DIR="$HOME/.local/share/piper-voices"

# Voice presets, picked and tuned by ear (A/B'd live, back to back) rather
# than by any formula. Switch with WAYLISPER_TTS_VOICE=lessac|female|jarvis.
# LENGTH_SCALE is Piper's native speed control (lower = faster). PITCH is a
# post-hoc rubberband shift (1 = untouched). REVERB, if non-empty, is an
# ffmpeg -af filter string. Both post-processing steps are skipped when
# unset, so lessac/female never pay ffmpeg's cost — only jarvis does.
case "${WAYLISPER_TTS_VOICE:-jarvis}" in
    lessac)
        MODEL="$VOICES_DIR/en_US-lessac-high.onnx"
        LENGTH_SCALE=1
        PITCH=1
        REVERB=""
        ;;
    female)
        MODEL="$VOICES_DIR/en_US-hfc_female-medium.onnx"
        LENGTH_SCALE=1
        PITCH=1
        REVERB=""
        ;;
    jarvis)
        # A voice actually trained to emulate JARVIS (MIT licensed), not a
        # generic voice pushed through speed/pitch tricks — sounds right
        # untouched. https://huggingface.co/jgkawell/jarvis
        #
        # Using the medium-quality tier, not high: benchmarked on path0s's
        # CPU, jarvis-high took 7.6s to synthesize one moderate sentence
        # while jarvis-medium took 3.2s (2.4x faster) for the same text --
        # the ffmpeg reverb pass below is negligible by comparison (~0.07s),
        # so model quality tier, not the reverb, was the real latency lever.
        # Same underlying voice, just the faster-to-synthesize checkpoint.
        MODEL="$VOICES_DIR/jarvis-medium.onnx"
        LENGTH_SCALE=1
        PITCH=1
        # Small-room reverb via layered short decaying echoes — this ffmpeg
        # build has no dedicated reverb filter (no afreeverb, no librubberband
        # convolution reverb), so aecho with several close, quickly-decaying
        # taps is the approximation. Tuned live, A/B'd back to back.
        REVERB="aecho=0.8:0.7:46|69|104:0.345|0.23|0.115"
        ;;
    *)
        echo "Unknown WAYLISPER_TTS_VOICE: ${WAYLISPER_TTS_VOICE}" >&2
        exit 1
        ;;
esac

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/waylisper"
if [ -f "$STATE_DIR/muted" ]; then
    exit 0
fi

TMP_WAV=$(mktemp --suffix=.wav)
trap 'rm -f "$TMP_WAV"' EXIT

INPUT=$(cat)
TEXT=$(printf '%s' "$INPUT" | jq -r '.last_assistant_message // empty')

if [ -z "$TEXT" ]; then
    exit 0
fi

CLEAN_TEXT=$(printf '%s' "$TEXT" | python3 -c '
import sys, re

text = sys.stdin.read()

# fenced code blocks -> drop entirely (usually not worth speaking)
text = re.sub(r"```.*?```", " code block omitted ", text, flags=re.DOTALL)
# inline code
text = re.sub(r"`([^`]*)`", r"\1", text)
# bold/italic markers
text = re.sub(r"\*\*\*(.*?)\*\*\*", r"\1", text)
text = re.sub(r"\*\*(.*?)\*\*", r"\1", text)
text = re.sub(r"\*(.*?)\*", r"\1", text)
text = re.sub(r"__(.*?)__", r"\1", text)
text = re.sub(r"_(.*?)_", r"\1", text)
# markdown links [text](url) -> text
text = re.sub(r"\[([^\]]*)\]\([^\)]*\)", r"\1", text)
# headers
text = re.sub(r"^#{1,6}\s*", "", text, flags=re.MULTILINE)
# bullet/list markers
text = re.sub(r"^[\s]*[-*+]\s+", "", text, flags=re.MULTILINE)
text = re.sub(r"^\s*\d+\.\s+", "", text, flags=re.MULTILINE)
# collapse whitespace
text = re.sub(r"\n{2,}", ". ", text)
text = re.sub(r"\n", " ", text)
text = re.sub(r"\s{2,}", " ", text)

sys.stdout.write(text.strip())
')

if [ -z "$CLEAN_TEXT" ]; then
    exit 0
fi

# Claim "latest" — if a newer invocation overwrites this before we get to
# play, we're stale and should skip instead of queuing behind it. Prevents
# a burst of rapid responses from all talking over each other at once.
TOKEN="$$-$RANDOM"
LATEST_FILE="${TMPDIR:-/tmp}/waylisper-speak-latest"
LOCK_FILE="${TMPDIR:-/tmp}/waylisper-speak.lock"
echo "$TOKEN" > "$LATEST_FILE"

printf '%s' "$CLEAN_TEXT" | python3 -m piper -m "$MODEL" -f "$TMP_WAV" --length-scale "$LENGTH_SCALE" >/dev/null 2>&1

FILTERS=""
[ "$PITCH" != 1 ] && FILTERS="rubberband=pitch=$PITCH"
if [ -n "$REVERB" ]; then
    FILTERS="${FILTERS:+$FILTERS,}$REVERB"
fi

if [ -n "$FILTERS" ]; then
    PROCESSED_WAV=$(mktemp --suffix=.wav)
    trap 'rm -f "$TMP_WAV" "$PROCESSED_WAV"' EXIT
    ffmpeg -y -i "$TMP_WAV" -af "$FILTERS" "$PROCESSED_WAV" >/dev/null 2>&1
    mv "$PROCESSED_WAV" "$TMP_WAV"
fi

(
    flock -x 200
    if [ "$(cat "$LATEST_FILE" 2>/dev/null)" = "$TOKEN" ]; then
        paplay "$TMP_WAV" >/dev/null 2>&1
    fi
) 200>"$LOCK_FILE"
